<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>gate</AssemblyName>
    <RootNamespace>Gate</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Packed as a .NET tool: dotnet pack -c Release, then dotnet tool install. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gate</ToolCommandName>
    <PackageId>CLean.Gate</PackageId>
    <Version>0.1.0</Version>
    <Description>The clean code gate: the core and its command, gate.</Description>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
