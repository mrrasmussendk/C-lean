#!/usr/bin/env node
"use strict";
// Prints the unsuppressed results of a SARIF file, one per line, and exits 1 when there are any.
const fs = require("node:fs");

const sarif = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const open = sarif.runs.flatMap((run) => run.results).filter((result) => !result.suppressions);
for (const result of open) {
  const place = result.locations[0].physicalLocation;
  console.log(`${place.artifactLocation.uri}:${place.region.startLine}: ${result.message.text}`);
}
console.log(`${open.length} unsuppressed findings`);
process.exit(open.length > 0 ? 1 : 0);
