#!/usr/bin/env python3
"""Checks `gate-csharp mutants` on checks/samples/mutants: every mutant, applied byte-wise,
differs from the original and still parses; the expected mutators, contexts and exclusions hold."""
import collections
import json
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
GATE = os.path.join(HERE, "..", "bin", "gate-csharp")
DEFAULTS = os.path.join(HERE, "..", "..", "..", "corpus", "defaults")
SAMPLE = os.path.join(HERE, "samples", "mutants")
COMMON = ["--config", os.path.join(DEFAULTS, "gate.yaml"), "--architecture", os.path.join(DEFAULTS, "architecture.yaml")]
EXPECTED = {"ArithmeticOperator": 4, "EqualityOperator": 5, "LogicalOperator": 2, "BooleanLiteral": 1, "UnaryOperator": 1}


def run(*arguments):
    done = subprocess.run([GATE, *arguments], capture_output=True, text=True)
    if done.returncode != 0:
        sys.exit("mutants-check: FAILED: gate-csharp %s exited %d: %s" % (arguments[0], done.returncode, done.stderr.strip()))


def mutants(out, *extra):
    run("mutants", "--root", SAMPLE, "--out", out, *COMMON, *extra)
    with open(os.path.join(out, "mutants.json"), encoding="utf-8") as handle:
        return json.load(handle)["mutants"]


def expect(condition, message):
    if not condition:
        sys.exit("mutants-check: FAILED: " + message)


def main():
    work = tempfile.mkdtemp(prefix="gate-mutants-")
    found = mutants(os.path.join(work, "out"))
    with open(os.path.join(SAMPLE, "Calc.cs"), "rb") as handle:
        original = handle.read()
    batch = os.path.join(work, "batch")
    os.makedirs(batch)
    for number, mutant in enumerate(found):
        expect(mutant["file"] == "Calc.cs", "mutant outside production code: %s" % mutant["id"])
        expect(original[mutant["start"]:mutant["end"]] == mutant["original"].encode(), "bytes at %s are not '%s'" % (mutant["id"], mutant["original"]))
        mutated = original[:mutant["start"]] + mutant["replacement"].encode() + original[mutant["end"]:]
        expect(mutated != original, "mutant %s does not change the file" % mutant["id"])
        line = original[:mutant["start"]].count(b"\n") + 1
        expect(line == mutant["line"], "line of %s is %d" % (mutant["id"], line))
        with open(os.path.join(batch, "m%03d.cs" % number), "wb") as handle:
            handle.write(mutated)
    run("analyze", "--root", batch, "--out", os.path.join(work, "parsed"), *COMMON, "--today", "2026-01-01")
    counts = collections.Counter(mutant["mutator"] for mutant in found)
    expect(dict(counts) == EXPECTED, "mutators are %s, expected %s" % (dict(counts), EXPECTED))
    contexts = collections.Counter(mutant["context"] for mutant in found)
    expect(contexts == {"guard": 3, "logging": 1, "": 9}, "contexts are %s" % dict(contexts))
    expect(len({mutant["id"] for mutant in found}) == len(found), "ids are not unique")
    expect(found == sorted(found, key=lambda m: (m["file"], m["start"], m["mutator"])), "mutants are not sorted")
    lines = os.path.join(work, "lines.yaml")
    with open(lines, "w") as handle:
        handle.write("lines:\n  - {path: Calc.cs, start: 19, end: 19}\n")
    on_line = mutants(os.path.join(work, "out2"), "--lines", lines)
    expect([m["line"] for m in on_line] == [19, 19, 19], "--lines 19..19 gave %s" % [m["id"] for m in on_line])
    shutil.rmtree(work)
    print("mutants-check: OK: %d mutants applied byte-wise, each differs and parses; mutators %s" % (len(found), dict(sorted(counts.items()))))


main()
